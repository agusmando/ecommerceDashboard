# URL base del backend (sin /api al final).
# Si se deja vacía, en desarrollo las llamadas a /api se redirigen vía proxy de Vite
# a VITE_API_PROXY_TARGET (evita problemas de CORS).
VITE_API_URL=

# Destino del proxy de desarrollo (solo `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:8080

# Timeout de las peticiones en milisegundos.
VITE_API_TIMEOUT=15000

# URL de la tienda: el login enlaza a su página de recuperar contraseña.
VITE_SHOP_URL=http://localhost:5173
