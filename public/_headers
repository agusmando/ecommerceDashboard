# Cloudflare Pages: headers por ruta (https://developers.cloudflare.com/pages/configuration/headers/)
# Sin 404.html en la raíz, Pages sirve index.html en cualquier ruta (fallback de SPA).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Los archivos de Vite llevan hash en el nombre: se pueden cachear para siempre
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Panel interno: que no lo indexen los buscadores
/*
  X-Robots-Tag: noindex, nofollow
